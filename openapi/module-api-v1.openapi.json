{
  "openapi": "3.1.0",
  "info": {
    "title": "MOX-ADV module API",
    "version": "1.0.0",
    "description": "Provider-neutral HTTP/JSON adapter for standalone Direct and Metrika modules."
  },
  "paths": {
    "/v1/runs": {
      "post": {
        "operationId": "invokeModuleV1",
        "summary": "Invoke the configured standalone module",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ModuleRequestV1"
              },
              "example": {
                "schema_version": "module-request-v1",
                "connection_ref": {
                  "connection_id": "customer-metrika-primary"
                },
                "environment": "PRODUCTION",
                "scope": {
                  "organization_id": "customer-42",
                  "campaign_id": "campaign-7",
                  "counter_id": "counter-9",
                  "goal_id": "goal-3"
                },
                "period": {
                  "start_date": "2026-07-01",
                  "end_date": "2026-07-29",
                  "timezone": "Europe/Moscow"
                },
                "objective": {
                  "code": "REDUCE_CPA",
                  "description": "Reduce CPA without losing qualified conversions."
                },
                "external_evidence": {
                  "schema_version": "normalized-metrics-evidence-v1",
                  "evidence_id": "customer-evidence-17",
                  "source": "CUSTOMER_ECOSYSTEM",
                  "observed_at": "2026-07-30T09:00:00+00:00",
                  "watermark": "2026-07-30T08:55:00+00:00",
                  "metrics": [
                    {
                      "name": "goal_visits",
                      "value": 21,
                      "unit": "COUNT"
                    },
                    {
                      "name": "cost_rub",
                      "value": "4200.00",
                      "unit": "RUB"
                    }
                  ]
                },
                "operation": {
                  "kind": "ANALYZE",
                  "operation_type": "ANALYZE_PERFORMANCE"
                },
                "idempotency_key": "customer-run-2026-07-30-001"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "The module completed or returned a partial analysis.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ModuleResultV1"
                },
                "example": {
                  "schema_version": "module-result-v1",
                  "run_id": "module-run-1",
                  "module": {
                    "module_id": "YANDEX_METRIKA",
                    "module_version": "1.0.0"
                  },
                  "status": "SUCCEEDED",
                  "metrics": [
                    {
                      "name": "goal_visits",
                      "value": 21,
                      "unit": "COUNT"
                    }
                  ],
                  "assessment": {
                    "summary": "The supplied evidence is sufficient for analysis.",
                    "data_quality_status": "READY",
                    "confidence_status": "READY"
                  },
                  "recommendations": [
                    {
                      "code": "KEEP_GOAL",
                      "summary": "Keep the current goal.",
                      "rationale": "The goal is collecting qualified conversions.",
                      "executable": false
                    }
                  ],
                  "hypotheses": [],
                  "proposal": null,
                  "execution_result": null,
                  "provenance": [
                    {
                      "source_type": "CUSTOMER_EVIDENCE",
                      "source": "CUSTOMER_ECOSYSTEM",
                      "retrieved_at": "2026-07-30T09:00:01+00:00",
                      "watermark": "2026-07-30T08:55:00+00:00",
                      "evidence_id": "customer-evidence-17"
                    }
                  ],
                  "warnings": [],
                  "errors": [],
                  "decision_record_ref": "decision-records/module-run-1.json"
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/ContractError"
          },
          "422": {
            "$ref": "#/components/responses/ModuleRejection"
          },
          "500": {
            "$ref": "#/components/responses/ModuleFailure"
          }
        }
      }
    }
  },
  "components": {
    "responses": {
      "ContractError": {
        "description": "The request does not satisfy ModuleRequestV1.",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/ModuleResultV1"
            }
          }
        }
      },
      "ModuleRejection": {
        "description": "The request is valid but blocked or rejected by the module.",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/ModuleResultV1"
            }
          }
        }
      },
      "ModuleFailure": {
        "description": "The module failed with a typed result.",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/ModuleResultV1"
            }
          }
        }
      }
    },
